# =====================================================================
#  Mess Management System - settings
#  Copy this file to backend\.env and fill in YOUR values locally.
#  Never commit .env or paste your real password into chat / code.
# =====================================================================

# --- Oracle connection (the schema that owns STUDENT, MENU, PAYMENT ...) ---
DB_USER=your_oracle_username
DB_PASSWORD=your_oracle_password_here
# host:port/service_name   e.g. localhost:1521/XEPDB1  (XE 18c/21c)
#                               localhost:1521/FREEPDB1 (23ai Free)
#                               localhost:1521/ORCLPDB  (Enterprise default)
DB_DSN=localhost:1521/XEPDB1
DB_POOL_MIN=1
DB_POOL_MAX=5

# --- Only for Oracle 11g / 12.1 and older (thin mode needs 12.1+) ---
# Install Oracle Instant Client and point to its folder.
ORACLE_THICK_MODE=false
ORACLE_CLIENT_LIB_DIR=C:\oracle\instantclient_21_13

# --- Login tokens ---
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480

# --- Frontend address(es) allowed to call the API ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
